# 环境变量样例：复制为 .env 后按需修改（.env 已在 .gitignore 中）
# 说明：所有配置都有合理默认值，最小可用只需提供 DEEPSEEK_API_KEY

# ---- 大模型 ----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# 主模型 / 备用模型（主模型失败时自动降级）
SDR_PRIMARY_PROVIDER=deepseek
SDR_FALLBACK_PROVIDER=dashscope
# 可选：覆盖默认模型
# SDR_MODEL_DEEPSEEK=deepseek-chat
# SDR_MODEL_DASHSCOPE=qwen-plus

# ---- 企业抬头还原：联网检索通道 ----
# 按顺序尝试，任一不可用自动跳到下一个；全部不可用则退化为「本地库 + LLM 推理」
# dashscope 需要账户可用（欠费会返回 Arrearage），html 为中文搜索引擎 best-effort 检索
SDR_ENABLE_WEB_SEARCH=1
SDR_SEARCH_PROVIDERS=dashscope,html
SDR_SEARCH_MODEL=qwen-plus

# ---- 语音转写（ASR）：录音直接出线索 ----
# 当前实现基于阿里云百炼 paraformer-v2，需要 DASHSCOPE_API_KEY
# 本地文件会先上传到百炼临时存储（有效期 48 小时）再转写
SDR_ASR_PROVIDER=dashscope
SDR_ASR_MODEL=paraformer-v2
SDR_ASR_LANGUAGE=zh
# 开启说话人分离，用于区分销售与客户话轮（仅单声道音频有效）
SDR_ASR_DIARIZATION=1
# 轮询转写结果的超时时间（秒）
SDR_ASR_POLL_TIMEOUT=600

# ---- 人工复核闸门 ----
# 整体置信度低于该值 -> 进人工复核队列
SDR_REVIEW_THRESHOLD=0.75
# 关键字段（企业抬头 / 意向等级）置信度低于该值 -> 进人工复核队列
SDR_CRITICAL_THRESHOLD=0.70

# ---- 服务 ----
SDR_API_HOST=127.0.0.1
SDR_API_PORT=8000

# ---- 稳健性 ----
SDR_REQUEST_TIMEOUT=90
SDR_MAX_RETRIES=2
SDR_TEMPERATURE=0.1
